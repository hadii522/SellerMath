# ==========================================
# SellerMath Environment Configuration
# ==========================================

# Public Brand Name & Domain (Configurable branding)
NEXT_PUBLIC_BRAND_NAME=SellerMath
NEXT_PUBLIC_SITE_URL=https://sellermath.com
NEXT_PUBLIC_DOMAIN=sellermath.com

# Google AdSense Monetization (Disabled by default)
# Set to 'true' only after your domain is approved by Google AdSense
NEXT_PUBLIC_ADS_ENABLED=false
NEXT_PUBLIC_ADSENSE_CLIENT_ID=ca-pub-XXXXXXXXXXXXXXXX

# Google Analytics 4 (Optional)
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
